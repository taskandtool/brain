# Never commit credentials or local state. Task & Tool delivers env to a
# machine at install time; nothing in this repo should ever hold a key.
.env
.env.*
!.env.template
!.env.example
.envrc
*.pem
*.key

# Tool noise
/dist/
# Quartz runs npm install in the linked plugin folder on each new machine.
/viewer/safe-text/package-lock.json
/viewer/safe-text/node_modules/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store

# Working knowledge is the owner's, made on their machine, never in this repo.
# The schema ships, and the owner edits it in place; each folder's README.md
# ships so the viewer has a page for it from the first start.
/raw/*
!/raw/README.md
/brain/*
!/brain/SCHEMA.md
/brand/*
!/brand/README.md
/public/*
!/public/README.md
/legal/

