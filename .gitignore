# Never commit credentials or local state. Task & Tool delivers env to a
# machine at install time; nothing in this repo should ever hold a key.
.env
.env.*
!.env.template
!.env.example
.envrc
*.pem
*.key

# Tool noise
/dist/
# Quartz runs npm install in the linked plugin folder on each new machine.
/viewer/*/package-lock.json
/viewer/*/node_modules/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store

# Working knowledge is the owner's, made on their machine, never in this repo.
# The schema ships, and the owner edits it in place; each folder's _index.md
# ships as its page in the viewer, from the first start.
/raw/*
!/raw/_index.md
/brain/*
!/brain/SCHEMA.md
/brand/*
!/brand/_index.md
/public/*
!/public/_index.md
/legal/

